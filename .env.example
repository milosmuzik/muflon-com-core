# Zkopíruj tento soubor jako .env a vlož skutečné hodnoty.
# DŮLEŽITÉ: vlastní, nové hodnoty pro Com Core - nesdílet s CZ Muflon Core.

# Lokální vývoj (Vercel Postgres / Neon - "Show secrets" v Vercel dashboardu,
# nebo si vytvoř zdarma projekt na neon.tech). Samostatná databáze, ne ta od CZ Core.
DATABASE_URL="postgresql://uzivatel:heslo@host/databaze?sslmode=require"

# Heslo do redakce. Bez této proměnné je přihlášení vypnuté.
AUTH_PASSWORD=""

# Volitelné. Katalog a zdroje jdou přes Metal Archives a MusicBrainz i bez něj.
# Gemini se použije jen když klíč existuje a není 429. Tady dělá většinu práce
# (dohledávání zdrojů, návrhy kalendáře, doplňování katalogu) - viz CLAUDE.md.
GEMINI_API_KEY=""

# Autorizace app/api/cron/* (volá je Vercel Cron podle vercel.json).
# Vygeneruj vlastní náhodný řetězec (např. `openssl rand -hex 32`).
CRON_SECRET=""

# Autorizace app/api/admin/import-karty (dávkový import karet).
# Vygeneruj vlastní náhodný řetězec, jiný než CRON_SECRET a jiný než u CZ Core.
IMPORT_API_KEY=""

# Základ pro absolutní URL (generování obrázků pro sociální sítě apod.).
# Nastav na skutečnou doménu, jakmile appku nasadíš.
NEXT_PUBLIC_APP_URL="https://muflon-com-core.vercel.app"

# Volitelné - publikace na sociální sítě (viz lib/actions/socialni.ts).
# Vlastní anglický FB/IG/X účet pro radiomuflon.com, jiný než CZ Core.
FACEBOOK_PAGE_ACCESS_TOKEN=""
FACEBOOK_PAGE_ID=""
INSTAGRAM_ACCOUNT_ID=""

# Volitelné - publikace na X/Twitter (kód existuje, ale u CZ Core se zatím
# nepoužívá - X byl vědomě vynechán, jen FB + IG). Nastav, jen pokud chceš
# pro Com Core X používat.
X_API_KEY=""
X_API_SECRET=""
X_ACCESS_TOKEN=""
X_ACCESS_TOKEN_SECRET=""
